 // Function to request a new container instance
+var containerReadyTimer = null;
+var containerReadyGeneration = {};
+function stop_readiness_poll() {
+	containerReadyGeneration = {};
+	clearTimeout(containerReadyTimer);
+	containerReadyTimer = null;
+}
+
+function poll_readiness(challenge_id) {
+	var generation = containerReadyGeneration;
+	if (!document.getElementById("container-connection-info") ||
+		parseInt(CTFd.lib.$("#challenge-id").val()) !== challenge_id) return;
+	var xhr = new XMLHttpRequest();
+	xhr.open("POST", "/containers/api/running", true);
+	xhr.setRequestHeader("Content-Type", "application/json");
+	xhr.setRequestHeader("CSRF-Token", init.csrfNonce);
+	xhr.timeout = 10000;
+	xhr.onload = function () {
+		if (generation !== containerReadyGeneration) return;
+		if (!document.getElementById("container-connection-info") ||
+			parseInt(CTFd.lib.$("#challenge-id").val()) !== challenge_id) return;
+		if (xhr.status !== 200) {
+			document.getElementById("container-connection-info").textContent = "Could not check Windows readiness. Reopen the challenge to try again.";
+			return;
+		}
+		var data = JSON.parse(xhr.responseText);
+		if (data.status !== "already_running") {
+			document.getElementById("container-connection-info").textContent = "Instance stopped or expired. Reopen this challenge to start another.";
+			return;
+		}
+		display_connection(data, challenge_id);
+	};
+	xhr.onerror = xhr.ontimeout = function () {
+		if (generation !== containerReadyGeneration) return;
+		if (document.getElementById("container-connection-info")) {
+			containerReadyTimer = setTimeout(function () { poll_readiness(challenge_id); }, 5000);
+		}
+	};
+	xhr.send(JSON.stringify({ chal_id: challenge_id }));
+}
+
+function display_connection(data, challenge_id) {
+	stop_readiness_poll();
+	var connectionInfo = document.getElementById("container-connection-info");
+	connectionInfo.replaceChildren();
+	if (data.protocol === "rdp" && !data.ready) {
+		connectionInfo.textContent = data.notice;
+		containerReadyTimer = setTimeout(function () { poll_readiness(challenge_id); }, 5000);
+		return;
+	}
+	var address = data.hostname + ":" + data.port;
+	if (data.protocol === "rdp") {
+		connectionInfo.textContent = "RDP: " + address + "\nUsername: " + data.username + "\nPassword: " + data.password + "\n" + data.notice;
+		connectionInfo.style.whiteSpace = "pre-wrap";
+	} else if (/^https?:\/\//.test(data.hostname)) {
+		var link = document.createElement("a");
+		link.href = address;
+		link.target = "_blank";
+		link.rel = "noopener";
+		link.textContent = address;
+		connectionInfo.appendChild(link);
+	} else {
+		connectionInfo.textContent = address;
+	}
+}
