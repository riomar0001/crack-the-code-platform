diff --git a/windows_instances.py b/windows_instances.py
new file mode 100644
--- /dev/null
+++ b/windows_instances.py
@@ -0,0 +1,114 @@
+"""Windows RDP instances cloned from an immutable, installed Dockur template."""
+
+import json
+import uuid
+import threading
+from functools import wraps
+
+import docker
+
+TEMPLATE_LABEL = "io.ctfd.windows.template"
+INSTANCE_LABEL = "io.ctfd.windows.instance"
+VOLUME_LABEL = "io.ctfd.windows.storage"
+NETWORK_LABEL = "io.ctfd.windows.network"
+_launch_lock = threading.Lock()
+
+
+def serialize_launch(function):
+    @wraps(function)
+    def wrapped(*args, **kwargs):
+        with _launch_lock:
+            return function(*args, **kwargs)
+    return wrapped
+
+
+def provision(client, image):
+    template = client.images.get(image).labels.get(TEMPLATE_LABEL)
+    if not template:
+        return None
+    # These are operator-created image labels, never participant input.
+    client.volumes.get(template)
+    running = client.containers.list(filters={"label": INSTANCE_LABEL})
+    if len(running) >= 2:
+        raise RuntimeError("Both Windows slots are in use. Try again after an instance stops.")
+    token = uuid.uuid4().hex
+    volume = client.volumes.create(name="ctfd-win-" + token,
+                                   labels={INSTANCE_LABEL: "true"})
+    network = None
+    try:
+        network = client.networks.create("ctfd-win-" + token, driver="bridge",
+                                         options={"com.docker.network.bridge.enable_icc": "false"},
+                                         labels={INSTANCE_LABEL: "true"})
+        script = '''set -e
+test -f /template/READY
+for f in windows.base windows.ver windows.boot windows.rom windows.vars; do
+    if [ -f /template/$f ]; then cp /template/$f /storage/$f; fi
+done
+qemu-img create -q -f qcow2 -F qcow2 -b /template/data.qcow2 /storage/data.qcow2
+cat /template/credentials.json
+'''
+        output = client.containers.run(image, entrypoint="/bin/bash", command=["-c", script],
+            volumes={template: {"bind": "/template", "mode": "ro"},
+                     volume.name: {"bind": "/storage", "mode": "rw"}}, remove=True,
+            network_disabled=True)
+        credentials = json.loads(output)
+        return dict(volumes={template: {"bind": "/template", "mode": "ro"},
+                             volume.name: {"bind": "/storage", "mode": "rw"}},
+                    devices=["/dev/kvm:/dev/kvm:rwm", "/dev/net/tun:/dev/net/tun:rwm"],
+                    cap_add=["NET_ADMIN"], network=network.name,
+                    environment={"DISK_FMT": "qcow2", "RAM_SIZE": "4G", "CPU_CORES": "2",
+                                 "USERNAME": credentials["username"], "PASSWORD": credentials["password"]},
+                    mem_limit="6g", cpu_period=100000, cpu_quota=200000,
+                    labels={INSTANCE_LABEL: "true", VOLUME_LABEL: volume.name,
+                            NETWORK_LABEL: network.name})
+    except Exception:
+        if network:
+            network.remove()
+        volume.remove()
+        raise
+
+
+def cleanup(client, labels):
+    if labels.get(INSTANCE_LABEL) != "true":
+        return
+    for collection, key in ((client.networks, NETWORK_LABEL), (client.volumes, VOLUME_LABEL)):
+        name = labels.get(key, "")
+        if not name.startswith("ctfd-win-"):
+            continue
+        try:
+            collection.get(name).remove()
+        except docker.errors.NotFound:
+            pass
+
+
+def connection_details(container):
+    if container.labels.get(INSTANCE_LABEL) != "true":
+        return {}
+    probe = '''import socket,sys,pathlib,ipaddress
+try:
+    leases=pathlib.Path("/var/lib/misc/dnsmasq.leases").read_text().splitlines()
+    addresses=[line.split()[2] for line in leases if len(line.split())>=3]
+    if not addresses: sys.exit(1)
+    address=str(ipaddress.IPv4Address(addresses[0]))
+    with socket.create_connection((address,3389),timeout=1.5) as s:
+        s.settimeout(1.5)
+        s.sendall(bytes.fromhex("030000130ee000000000000100080003000000"))
+        reply=b""
+        while len(reply)<19:
+            chunk=s.recv(19-len(reply))
+            if not chunk: break
+            reply+=chunk
+        sys.exit(0 if len(reply)>=19 and reply[5]==0xd0 and reply[11]==2 else 1)
+except OSError:
+    sys.exit(1)
+'''
+    try:
+        ready = container.exec_run(["python3", "-c", probe]).exit_code == 0
+    except docker.errors.APIError:
+        ready = False
+    if not ready:
+        return {"protocol": "rdp", "ready": False, "hostname": None, "port": None,
+                "notice": "Windows is booting. Connection details will appear when RDP is ready."}
+    env = dict(item.split("=", 1) for item in container.attrs["Config"]["Env"] if "=" in item)
+    return {"protocol": "rdp", "ready": True, "username": env["USERNAME"], "password": env["PASSWORD"],
+            "notice": "Windows is ready for Remote Desktop."}
